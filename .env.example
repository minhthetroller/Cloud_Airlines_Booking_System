# Postgres and Redis (see docker-compose.yml)
DATABASE_URL=postgres://cabs:cabs@localhost:5433/cabs
REDIS_URL=redis://localhost:6379

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend
RESEND_API_KEY=
# Sender address. Without a verified domain use Resend's test sender below; it only delivers
# to the email address of your own Resend account. Leave unset in production to send from
# noreply@cloud-airlines.space.
RESEND_FROM="Cloud Airline <onboarding@resend.dev>"
